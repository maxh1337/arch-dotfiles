#!/bin/bash

WALL_DIR="$HOME/Pictures"

WALLSET="/home/maxh/.local/bin/wallset-backend"

SELECTED_WALL=$(find "$WALL_DIR" -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.png" \) \
    | sed "s|$WALL_DIR/||" \
    | rofi -dmenu -i -p "Select wallpaper:")

if [ -z "$SELECTED_WALL" ]; then
    notify-send "❌ Cancelled" "No wallpaper selected."
    exit 0
fi

SELECTED_WALL=$(echo "$SELECTED_WALL" | xargs) # sanitize
FULL_PATH="$WALL_DIR/$SELECTED_WALL"

notify-send "🎨 Applying" "Wallpaper: $SELECTED_WALL"

sleep 0.5

"$WALLSET" "$FULL_PATH"
