{
    "clock": {
        "format": "<span font='14'></span> {:%H:%M  <span font='14'>\uf073</span> %d-%m-%Y}",
        "tooltip": false
    },
    "cpu": {
        "format": "<span font='14'></span> {}%",
        "interval": 15,
        "max-length": 10,
        "tooltip": false
    },
    "font": "JetBrains Nerd Font 10, Symbols Nerd Font Mono 10",
    "hyprland/language": {
        "format": "<span font='13'>\uf0ac</span> {}",
        "format-en": "EN",
        "format-ru": "RU"
    },
    "hyprland/workspaces": {
        "all-outputs": true,
        "disable-scroll": true,
        "format": "{name}",
        "format-icons": {
            "1": "󰖟",
            "10": "",
            "2": "",
            "3": "",
            "4": "󰭹",
            "5": "󰕧",
            "6": "",
            "7": "",
            "8": "󰣇",
            "9": ""
        },
        "persistent-workspaces": {
            "*": 5
        }
    },
    "layer": "top",
    "memory": {
        "format": "<span font='13'>󰍛</span> {}%",
        "interval": 5,
        "max-length": 10,
        "tooltip": false
    },
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-left": [
        "memory",
        "cpu",
        "tray"
    ],
    "modules-right": [
        "network",
        "pulseaudio",
        "hyprland/language",
        "clock"
    ],
    "network": {
        "format": "󰤨",
        "format-disabled": "󰤮",
        // "format-linked":
        "format-disconnected": "󰤯",
        "format-ethernet": "<span font='14'>󰈀</span>",
        // "format-alt":
        "format-icons": [
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],
        "format-wifi": "{icon}",
        "tooltip": true,
        "tooltip-format": "Interface: {ifname}\nIP: {ipaddr}"
    },
    "pulseaudio": {
        "format": "<span font='12'></span> {volume: >3}%",
        "on-click": "pavucontrol",
        "tooltip": true
    },
    "tray": {
        "icon-size": 15,
        "spacing": 8
    }
}
